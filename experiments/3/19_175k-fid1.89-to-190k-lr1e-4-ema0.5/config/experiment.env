# Experiment 3-19 defaults.
#
# Starts from the Experiment 3-18 175k checkpoint whose 3-seed FID is
# approximately 1.89, continues training to 190k with lr=1e-4/EMA=0.5,
# then evaluates every generated checkpoint in (175k, 190k] with three
# FID-50k seed ranges.

EXP_ROOT="experiments/3/19_175k-fid1.89-to-190k-lr1e-4-ema0.5"
RUN_DIR="$EXP_ROOT/training-runs/lr1e-4-ema0.5-175k-190k"
FID_ROOT="$EXP_ROOT/fid-evals/lr1e-4-ema0.5-175k-190k"
RESULTS_DIR="$EXP_ROOT/results"
LOG_DIR="$EXP_ROOT/logs"

BASE_RUN="experiments/3/18_160k-fid2.05-to-175k-lr1e-4-ema0.5/training-runs/lr1e-4-ema0.5-160k-175k"
BASE_STATE="$BASE_RUN/training-state-175000.pt"
BASE_SNAPSHOT="$BASE_RUN/network-snapshot-175000.pkl"

DATASET="datasets/cifar10-32x32.zip"
FID_REF="fid-refs/cifar10-32x32.npz"

START_KIMG="175000"
TARGET_KIMG="190000"
LR="0.0001"
EMA="0.5"
TICK_KIMG="50"
SNAP_TICKS="50"
DUMP_TICKS="50"
BATCH_GPU="128"
TRAIN_SEED="0"

FID_SEEDS_LIST="0-49999 50000-99999 100000-149999"
NUM_IMAGES="50000"
STEPS="18"
S_CHURN="0"
S_MIN="0"
S_MAX="inf"
S_NOISE="1"
GEN_BATCH="64"
FID_BATCH="64"
