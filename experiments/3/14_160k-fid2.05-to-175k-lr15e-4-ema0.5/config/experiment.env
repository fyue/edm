# Experiment 3-14 defaults.
#
# Starts from the 160k lr=1e-3/EMA=0.5 repro branch whose 3-seed FID is
# approximately 2.05, continues training to 175k with lr=15e-4/EMA=0.5,
# then evaluates every generated checkpoint in (160k, 175k] with three
# FID-50k seed ranges.

EXP_ROOT="experiments/3/14_160k-fid2.05-to-175k-lr15e-4-ema0.5"
RUN_DIR="$EXP_ROOT/training-runs/lr15e-4-ema0.5-160k-175k"
FID_ROOT="$EXP_ROOT/fid-evals/lr15e-4-ema0.5-160k-175k"
RESULTS_DIR="$EXP_ROOT/results"
LOG_DIR="$EXP_ROOT/logs"

BASE_RUN="experiments/3/1_120k-160k-lr-ema-sweep/training-runs/lr1e-3-ema0.5-repro"
BASE_STATE="$BASE_RUN/training-state-160000.pt"
BASE_SNAPSHOT="$BASE_RUN/network-snapshot-160000.pkl"

DATASET="datasets/cifar10-32x32.zip"
FID_REF="fid-refs/cifar10-32x32.npz"

START_KIMG="160000"
TARGET_KIMG="175000"
LR="0.0015"
EMA="0.5"
TICK_KIMG="50"
SNAP_TICKS="50"
DUMP_TICKS="50"
BATCH_GPU="128"
TRAIN_SEED="0"

FID_SEEDS_LIST="0-49999 50000-99999 100000-149999"
NUM_IMAGES="50000"
STEPS="18"
S_CHURN="0"
S_MIN="0"
S_MAX="inf"
S_NOISE="1"
GEN_BATCH="64"
FID_BATCH="64"
