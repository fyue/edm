# Experiment 3-11 defaults.
#
# Evaluate four lr=5e-4/EMA=0.5 checkpoints around 170k with three
# FID-50k seed ranges. The checkpoint list is kept in checkpoints.tsv so
# the exact four points can be adjusted without editing the runner.

EXP_ROOT="experiments/3/11_fid50k_around170k_lr5e-4_ema0.5"
CHECKPOINTS_TSV="$EXP_ROOT/config/checkpoints.tsv"
IMAGE_ROOT="$EXP_ROOT/images"
RESULTS_DIR="$EXP_ROOT/results"
LOG_DIR="$EXP_ROOT/logs"

FID_REF="fid-refs/cifar10-32x32.npz"

FID_SEEDS_LIST="0-49999 50000-99999 100000-149999"
NUM_IMAGES="50000"
STEPS="18"
S_CHURN="0"
S_MIN="0"
S_MAX="inf"
S_NOISE="1"
GEN_BATCH="64"
FID_BATCH="64"
LR="0.0005"
EMA="0.5"
