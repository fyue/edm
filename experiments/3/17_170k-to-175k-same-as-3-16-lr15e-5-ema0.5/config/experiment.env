# Experiment 3-17 defaults.
#
# Starts from the 170k checkpoint produced by Experiment 3-16, continues
# training to 175k with the same lr=15e-5/EMA=0.5 setting, then evaluates
# every generated checkpoint in (170k, 175k] with three FID-50k seed ranges.

EXP_ROOT="experiments/3/17_170k-to-175k-same-as-3-16-lr15e-5-ema0.5"
RUN_DIR="$EXP_ROOT/training-runs/lr15e-5-ema0.5-170k-175k"
FID_ROOT="$EXP_ROOT/fid-evals/lr15e-5-ema0.5-170k-175k"
RESULTS_DIR="$EXP_ROOT/results"
LOG_DIR="$EXP_ROOT/logs"

BASE_RUN="experiments/3/16_160k-fid2.05-to-170k-lr15e-5-ema0.5/training-runs/lr15e-5-ema0.5-160k-170k"
BASE_STATE="$BASE_RUN/training-state-170000.pt"
BASE_SNAPSHOT="$BASE_RUN/network-snapshot-170000.pkl"

DATASET="datasets/cifar10-32x32.zip"
FID_REF="fid-refs/cifar10-32x32.npz"

START_KIMG="170000"
TARGET_KIMG="175000"
LR="0.00015"
EMA="0.5"
TICK_KIMG="50"
SNAP_TICKS="50"
DUMP_TICKS="50"
BATCH_GPU="128"
TRAIN_SEED="0"

FID_SEEDS_LIST="0-49999 50000-99999 100000-149999"
NUM_IMAGES="50000"
STEPS="18"
S_CHURN="0"
S_MIN="0"
S_MAX="inf"
S_NOISE="1"
GEN_BATCH="64"
FID_BATCH="64"
